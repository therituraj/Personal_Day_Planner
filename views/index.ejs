<%- include('partials/navbar') %>

<main class="relative overflow-hidden">
  <section class="mx-auto max-w-6xl px-4 pb-16 pt-16 sm:px-6 sm:pt-24">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full bg-white/70 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-clay-600 ring-1 ring-ink-900/10">
          A calmer kind of productivity
        </p>
        <h1 class="mt-6 font-display text-5xl leading-[1.05] text-ink-950 sm:text-6xl">
          Plan your day<br />in your way.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-700/80">
          Dayline is a personal planner that keeps one day in focus. Add what matters, mark what moved, and leave the rest for tomorrow — without the noise of a typical task app.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/users/register" class="btn btn-accent px-6">Start planning free</a>
          <a href="/users/login" class="btn btn-ghost px-6">I already have an account</a>
        </div>
      </div>

      <div class="card p-6 sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-700/50">Today’s rhythm</p>
        <div class="mt-4 space-y-3">
          <% const samples = [
            { t: 'Morning stretch & tea', s: 'Done', c: 'bg-moss-500/15 text-moss-600' },
            { t: 'Deep work: proposal draft', s: 'Now', c: 'bg-clay-500/15 text-clay-600' },
            { t: 'Walk after lunch', s: 'Later', c: 'bg-sand-200 text-ink-700' },
            { t: 'Call with Priya', s: 'Later', c: 'bg-sand-200 text-ink-700' }
          ]; samples.forEach((item) => { %>
            <div class="flex items-center justify-between rounded-2xl bg-sand-50 px-4 py-3 ring-1 ring-ink-900/5">
              <span class="font-medium"><%= item.t %></span>
              <span class="badge <%= item.c %>"><%= item.s %></span>
            </div>
          <% }) %>
        </div>
        <p class="mt-5 text-sm text-ink-700/60">Pick a date. Fill the day. Close the loop.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-24 sm:px-6">
    <div class="grid gap-5 md:grid-cols-3">
      <article class="card p-6">
        <h2 class="font-display text-2xl">One date at a time</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-700/75">Jump through the calendar and see only that day’s work. No endless backlog staring back at you.</p>
      </article>
      <article class="card p-6">
        <h2 class="font-display text-2xl">Honest status</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-700/75">Pending, done, or not completed — so you can tell the difference between delayed and finished.</p>
      </article>
      <article class="card p-6">
        <h2 class="font-display text-2xl">Admin clarity</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-700/75">Workspace admins can see who is active, how people are progressing, and step in when an account needs help.</p>
      </article>
    </div>
  </section>
</main>
