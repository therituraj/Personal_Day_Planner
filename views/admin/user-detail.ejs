<%- include('../partials/navbar') %>

<main class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
  <%- include('../partials/flash') %>

  <a href="/admin/users" class="text-sm font-semibold text-clay-600">← Back to people</a>

  <div class="mt-4 grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
    <section class="card p-6">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-clay-600">Profile</p>
      <h1 class="mt-1 font-display text-4xl"><%= profile.name %></h1>
      <p class="mt-1 text-ink-700/70"><%= profile.email %></p>

      <dl class="mt-6 space-y-3 text-sm">
        <div class="flex justify-between gap-4">
          <dt class="text-ink-700/60">Role</dt>
          <dd class="font-semibold"><%= profile.role %></dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-ink-700/60">Account</dt>
          <dd class="font-semibold"><%= profile.isActive === false ? 'Disabled' : 'Active' %></dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-ink-700/60">Joined</dt>
          <dd><%= formatDate(profile.date) %></dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-ink-700/60">Last sign-in</dt>
          <dd><%= formatDate(profile.lastLogin) %></dd>
        </div>
      </dl>

      <div class="mt-6 grid grid-cols-2 gap-3">
        <div class="rounded-2xl bg-sand-50 p-4 text-center">
          <p class="font-display text-3xl text-moss-600"><%= stats.completed %></p>
          <p class="text-xs text-ink-700/60">Completed</p>
        </div>
        <div class="rounded-2xl bg-sand-50 p-4 text-center">
          <p class="font-display text-3xl"><%= stats.total %></p>
          <p class="text-xs text-ink-700/60">Total tasks</p>
        </div>
        <div class="rounded-2xl bg-sand-50 p-4 text-center">
          <p class="font-display text-3xl text-clay-600"><%= stats.pending %></p>
          <p class="text-xs text-ink-700/60">Pending</p>
        </div>
        <div class="rounded-2xl bg-sand-50 p-4 text-center">
          <p class="font-display text-3xl text-red-700"><%= stats.notCompleted %></p>
          <p class="text-xs text-ink-700/60">Not completed</p>
        </div>
      </div>

      <div class="mt-6 flex flex-col gap-2">
        <form method="POST" action="/admin/users/<%= profile._id %>/role">
          <input type="hidden" name="role" value="<%= profile.role === 'admin' ? 'user' : 'admin' %>" />
          <button class="btn btn-ghost w-full" type="submit">
            <%= profile.role === 'admin' ? 'Remove admin role' : 'Make admin' %>
          </button>
        </form>
        <form method="POST" action="/admin/users/<%= profile._id %>/toggle">
          <button class="btn <%= profile.isActive === false ? 'btn-primary' : 'btn-danger' %> w-full" type="submit">
            <%= profile.isActive === false ? 'Re-enable account' : 'Disable account' %>
          </button>
        </form>
      </div>
    </section>

    <section>
      <h2 class="font-display text-2xl">Their days</h2>
      <p class="mb-4 text-sm text-ink-700/70">Read-only view of planned work.</p>
      <% if (!docs.length) { %>
        <div class="card p-8 text-center text-ink-700/70">No tasks yet.</div>
      <% } %>
      <div class="space-y-4">
        <% docs.forEach((doc) => { %>
          <article class="card p-5">
            <h3 class="font-semibold"><%= doc.date %></h3>
            <ul class="mt-3 space-y-2">
              <% doc.tasks.forEach((task) => { %>
                <li class="flex items-start justify-between gap-3 rounded-2xl bg-sand-50 px-3 py-2">
                  <div>
                    <p class="font-medium"><%= task.title %></p>
                    <% if (task.description) { %>
                      <p class="text-xs text-ink-700/70"><%= task.description %></p>
                    <% } %>
                  </div>
                  <span class="badge shrink-0
                    <%= task.status === 'COMPLETED' ? 'bg-moss-500/15 text-moss-600' : (task.status === 'PENDING' ? 'bg-clay-500/15 text-clay-600' : 'bg-red-100 text-red-700') %>">
                    <%= task.status.replace('_', ' ').toLowerCase() %>
                  </span>
                </li>
              <% }) %>
            </ul>
          </article>
        <% }) %>
      </div>
    </section>
  </div>
</main>
