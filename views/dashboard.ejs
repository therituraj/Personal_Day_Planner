<%- include('partials/navbar') %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

<main class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
  <%- include('partials/flash') %>

  <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-clay-600">Hello, <%= user.name.split(' ')[0] %></p>
      <h1 class="mt-1 font-display text-4xl text-ink-950">Let’s make today count.</h1>
      <p class="mt-2 text-ink-700/70">You’re looking at <span class="font-semibold text-ink-900"><%= currentDate %></span>. Add a task, then move through the day at your own pace.</p>
    </div>
    <a href="#task_form" class="btn btn-accent self-start">Add a task</a>
  </div>

  <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="card p-5">
      <p class="text-sm text-ink-700/60">Today’s progress</p>
      <p class="mt-1 font-display text-4xl"><%= progress %>%</p>
      <div class="mt-3 h-2 overflow-hidden rounded-full bg-sand-200">
        <div class="h-full rounded-full bg-clay-500" style="width: <%= progress %>%"></div>
      </div>
      <p class="mt-2 text-xs text-ink-700/60"><%= todayCounts.completed %> of <%= todayCounts.total %> finished today</p>
    </div>
    <div class="card p-5">
      <p class="text-sm text-ink-700/60">Completed (all time)</p>
      <p class="mt-1 font-display text-4xl text-moss-600"><%= completed %></p>
    </div>
    <div class="card p-5">
      <p class="text-sm text-ink-700/60">Still pending</p>
      <p class="mt-1 font-display text-4xl text-clay-600"><%= pending %></p>
    </div>
    <div class="card p-5">
      <p class="text-sm text-ink-700/60">Not completed</p>
      <p class="mt-1 font-display text-4xl text-red-700"><%= notCompleted %></p>
    </div>
  </div>

  <section class="mt-8 grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
    <div>
      <div class="mb-4 flex items-center justify-between">
        <h2 class="font-display text-2xl">Tasks for this day</h2>
        <div class="flex gap-2 text-xs">
          <button type="button" data-filter="all" class="filter-chip badge bg-ink-900 text-white">All</button>
          <button type="button" data-filter="PENDING" class="filter-chip badge bg-sand-200 text-ink-800">Pending</button>
          <button type="button" data-filter="COMPLETED" class="filter-chip badge bg-sand-200 text-ink-800">Done</button>
        </div>
      </div>

      <% if (tasks.length > 0) { %>
        <div class="space-y-3" id="task-list">
          <% tasks.forEach((task) => { %>
            <article class="task-card" data-status="<%= task.status %>">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h3 class="text-lg font-semibold <%= task.status === 'COMPLETED' ? 'line-through text-ink-700/50' : '' %>"><%= task.title %></h3>
                  <% if (task.description) { %>
                    <p class="mt-1 text-sm leading-relaxed text-ink-700/75"><%= task.description %></p>
                  <% } %>
                  <% if (task.status === 'COMPLETED') { %>
                    <span class="badge mt-3 bg-moss-500/15 text-moss-600">Completed</span>
                  <% } else if (task.status === 'PENDING') { %>
                    <span class="badge mt-3 bg-clay-500/15 text-clay-600">Pending</span>
                  <% } else { %>
                    <span class="badge mt-3 bg-red-100 text-red-700">Not completed</span>
                  <% } %>
                </div>
                <div class="relative">
                  <button type="button" class="dropdown-button btn btn-ghost px-3 py-1.5 text-xs" onclick="toggleDropdown(this)">
                    Actions
                  </button>
                  <div class="dropdown-menu hidden">
                    <button type="button" class="block w-full px-4 py-2 text-left text-sm hover:bg-sand-100" onclick="updateStatus('<%= task._id %>', 'pending')">Mark pending</button>
                    <button type="button" class="block w-full px-4 py-2 text-left text-sm hover:bg-sand-100" onclick="updateStatus('<%= task._id %>', 'completed')">Mark completed</button>
                    <button type="button" class="block w-full px-4 py-2 text-left text-sm hover:bg-sand-100" onclick="updateStatus('<%= task._id %>', 'notcompleted')">Not completed</button>
                    <button type="button" class="block w-full px-4 py-2 text-left text-sm hover:bg-sand-100"
                      onclick="openEdit('<%= task._id %>', <%= JSON.stringify(task.title) %>, <%= JSON.stringify(task.description || '') %>)">
                      Edit
                    </button>
                    <form action="/tasks/delete/<%= task._id %>?date=<%= currentDate %>" method="POST">
                      <button type="submit" class="block w-full px-4 py-2 text-left text-sm text-red-700 hover:bg-red-50">Delete</button>
                    </form>
                  </div>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
        <% if (todayCounts.total > 0 && todayCounts.completed === todayCounts.total) { %>
          <div class="mt-6 rounded-3xl bg-moss-500/10 p-5 text-moss-600">
            <p class="font-display text-2xl">That’s a wrap.</p>
            <p class="mt-1 text-sm">Every task for this date is complete. Rest easy — tomorrow is a fresh page.</p>
          </div>
        <% } %>
      <% } else { %>
        <div class="card p-10 text-center">
          <p class="font-display text-2xl">This day is still open.</p>
          <p class="mt-2 text-sm text-ink-700/70">No tasks yet. Add the first one and give the day a shape.</p>
          <a href="#task_form" class="btn btn-primary mt-5">Write the first task</a>
        </div>
      <% } %>
    </div>

    <aside class="space-y-6">
      <div class="card p-5">
        <h2 class="font-display text-2xl">Calendar</h2>
        <p class="mb-3 text-sm text-ink-700/60">Choose any date to review or plan ahead.</p>
        <div id="calendar_view"></div>
      </div>

      <div class="card p-6" id="task_form">
        <h2 class="font-display text-2xl">Add task</h2>
        <p class="text-sm text-ink-700/60">This lands on <%= currentDate %>.</p>
        <form action="/dashboard/task" method="POST" class="mt-4 space-y-3">
          <input type="hidden" name="date" value="<%= currentDate %>">
          <div>
            <label for="task_title" class="text-sm font-medium">Title</label>
            <input type="text" id="task_title" name="title" required placeholder="What needs doing?" class="field">
          </div>
          <div>
            <label for="description" class="text-sm font-medium">Notes</label>
            <textarea id="description" name="description" rows="3" placeholder="Optional context…" class="field"></textarea>
          </div>
          <button type="submit" class="btn btn-primary w-full">Add to this day</button>
        </form>
      </div>
    </aside>
  </section>
</main>

<div id="edit-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-ink-950/40 p-4">
  <div class="card w-full max-w-md p-6">
    <h2 class="font-display text-2xl">Edit task</h2>
    <form id="edit-form" method="POST" class="mt-4 space-y-3">
      <input type="hidden" name="date" value="<%= currentDate %>">
      <div>
        <label class="text-sm font-medium">Title</label>
        <input id="edit-title" name="title" required class="field">
      </div>
      <div>
        <label class="text-sm font-medium">Notes</label>
        <textarea id="edit-description" name="description" rows="3" class="field"></textarea>
      </div>
      <div class="flex gap-2">
        <button type="submit" class="btn btn-primary flex-1">Save</button>
        <button type="button" class="btn btn-ghost flex-1" onclick="closeEdit()">Cancel</button>
      </div>
    </form>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    flatpickr("#calendar_view", {
      inline: true,
      defaultDate: "<%= currentDate %>",
      onChange: function(selectedDates, dateStr) {
        window.location.href = `/dashboard?date=${dateStr}`;
      },
    });
  });

  function toggleDropdown(button) {
    document.querySelectorAll(".dropdown-menu").forEach((menu) => {
      if (menu !== button.nextElementSibling) menu.classList.add("hidden");
    });
    button.nextElementSibling.classList.toggle("hidden");
  }

  window.addEventListener("click", function (event) {
    if (!event.target.closest(".dropdown-button") && !event.target.closest(".dropdown-menu")) {
      document.querySelectorAll(".dropdown-menu").forEach((menu) => menu.classList.add("hidden"));
    }
  });

  async function updateStatus(taskId, status) {
    const endpointMap = {
      pending: `/tasks/${taskId}/status/pending`,
      notcompleted: `/tasks/${taskId}/status/notcompleted`,
      completed: `/tasks/${taskId}/status/completed`,
    };
    try {
      const response = await fetch(endpointMap[status], { method: "PATCH" });
      const data = await response.json();
      if (response.ok) location.reload();
      else alert(data.error || "Failed to update status");
    } catch (error) {
      alert("An error occurred: " + error.message);
    }
  }

  function openEdit(id, title, description) {
    const modal = document.getElementById("edit-modal");
    document.getElementById("edit-form").action = `/tasks/edit/${id}`;
    document.getElementById("edit-title").value = title;
    document.getElementById("edit-description").value = description;
    modal.classList.remove("hidden");
    modal.classList.add("flex");
  }

  function closeEdit() {
    const modal = document.getElementById("edit-modal");
    modal.classList.add("hidden");
    modal.classList.remove("flex");
  }

  document.querySelectorAll(".filter-chip").forEach((chip) => {
    chip.addEventListener("click", () => {
      const filter = chip.dataset.filter;
      document.querySelectorAll(".filter-chip").forEach((c) => {
        c.classList.remove("bg-ink-900", "text-white");
        c.classList.add("bg-sand-200", "text-ink-800");
      });
      chip.classList.remove("bg-sand-200", "text-ink-800");
      chip.classList.add("bg-ink-900", "text-white");
      document.querySelectorAll("#task-list .task-card").forEach((card) => {
        card.classList.toggle("hidden", filter !== "all" && card.dataset.status !== filter);
      });
    });
  });
</script>
